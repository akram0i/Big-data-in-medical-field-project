0: jdbc:hive2://localhost:10000/default> -- Problem 4 check (answer key: ~53% denied without a valid primary dx vs ~6% with one; first submissions only)
0: jdbc:hive2://localhost:10000/default> SELECT p.has_valid_primary, COUNT(*) AS claims,
. . . . . . . . . . . . . . . . . . . .>        SUM(IF(c.status = 'DENIED', 1, 0)) AS denied,
. . . . . . . . . . . . . . . . . . . .>        ROUND(100 * SUM(IF(c.status = 'DENIED', 1, 0)) / COUNT(*), 1) AS denied_pct
. . . . . . . . . . . . . . . . . . . .> FROM claims c JOIN enc_primary_dx p ON TRIM(c.encounter_id) = p.encounter_id
. . . . . . . . . . . . . . . . . . . .> WHERE COALESCE(TRIM(c.resubmission_of), '') = ''
