0: jdbc:hive2://localhost:10000/default> -- 2. mrn_map: patient de-duplication
0: jdbc:hive2://localhost:10000/default> -- Match key = first + last name (lower-case, spaces/hyphens removed, order-insensitive
0: jdbc:hive2://localhost:10000/default> -- so swapped first/last names and 'Al ' vs 'Al-' still match) + date of birth.
0: jdbc:hive2://localhost:10000/default> -- Phone is NOT used: on the sample, duplicate registrations (AHD2xxxxxx
0: jdbc:hive2://localhost:10000/default> -- vs AHD1xxxxxx) have different phone numbers, but the same policy number.
0: jdbc:hive2://localhost:10000/default> -- Patients with no usable DOB/name are never merged (key = own MRN).
0: jdbc:hive2://localhost:10000/default> -- Master MRN = original AHD1... id if present, else earliest registration.
0: jdbc:hive2://localhost:10000/default> -- ---------------------------------------------------------------------
0: jdbc:hive2://localhost:10000/default> CREATE TABLE mrn_map (std_mrn STRING, master_mrn STRING) STORED AS ORC;
No rows affected (0.083 seconds)
0: jdbc:hive2://localhost:10000/default> 
0: jdbc:hive2://localhost:10000/default> WITH p AS (
. . . . . . . . . . . . . . . . . . . .>   SELECT std_mrn(mrn) AS std_mrn,
. . . . . . . . . . . . . . . . . . . .>          REGEXP_REPLACE(LOWER(TRIM(first_name)),'[ -]','') AS fname,
. . . . . . . . . . . . . . . . . . . .>          REGEXP_REPLACE(LOWER(TRIM(last_name)),'[ -]','') AS lname,
. . . . . . . . . . . . . . . . . . . .>          to_dt(date_of_birth) AS dob, to_dt(registration_date) AS reg
. . . . . . . . . . . . . . . . . . . .>   FROM patients),
. . . . . . . . . . . . . . . . . . . .> k AS (
. . . . . . . . . . . . . . . . . . . .>   SELECT std_mrn, reg,
. . . . . . . . . . . . . . . . . . . .>          CASE WHEN dob IS NULL OR COALESCE(fname,'') = '' OR COALESCE(lname,'') = '' THEN std_mrn
. . . . . . . . . . . . . . . . . . . .>               ELSE CONCAT_WS('|', LEAST(fname, lname), GREATEST(fname, lname), CAST(dob AS STRING)) END AS match_key
. . . . . . . . . . . . . . . . . . . .>   FROM p)
. . . . . . . . . . . . . . . . . . . .> INSERT OVERWRITE TABLE mrn_map
. . . . . . . . . . . . . . . . . . . .> SELECT DISTINCT std_mrn,
. . . . . . . . . . . . . . . . . . . .>        FIRST_VALUE(std_mrn) OVER (PARTITION BY match_key
. . . . . . . . . . . . . . . . . . . .>             ORDER BY CASE WHEN std_mrn LIKE 'AHD2%' THEN 1 ELSE 0 END, reg, std_mrn) AS master_mrn
. . . . . . . . . . . . . . . . . . . .> FROM k;
