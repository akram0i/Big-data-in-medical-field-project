0: jdbc:hive2://localhost:10000/default> -- Does each encounter have a valid PRIMARY diagnosis? (used for problem 4, claim denials)
0: jdbc:hive2://localhost:10000/default> CREATE VIEW enc_primary_dx AS
. . . . . . . . . . . . . . . . . . . .> SELECT e.encounter_id,
. . . . . . . . . . . . . . . . . . . .>        MAX(CASE WHEN d.dx_type = 'PRIMARY' AND d.dx_valid = 'Y' THEN 1 ELSE 0 END) AS has_valid_primary
. . . . . . . . . . . . . . . . . . . .> FROM curated_encounters e LEFT OUTER JOIN curated_diagnoses d ON e.encounter_id = d.encounter_id
. . . . . . . . . . . . . . . . . . . .> GROUP BY e.encounter_id;
