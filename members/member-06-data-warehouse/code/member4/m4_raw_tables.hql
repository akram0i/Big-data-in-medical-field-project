-- Member 4's raw external tables (DDL from Member 4's report), database default.
-- claims points at the billing_oracle folder, which holds only claims.csv on this VM.
USE default;
CREATE EXTERNAL TABLE IF NOT EXISTS patients (mrn STRING, first_name STRING, last_name STRING, gender STRING, date_of_birth STRING, nationality STRING, emirate STRING, mobile STRING, insurance_payer STRING, policy_number STRING, registration_date STRING) ROW FORMAT SERDE 'org.apache.hadoop.hive.serde2.OpenCSVSerde' WITH SERDEPROPERTIES ("separatorChar" = ",", "quoteChar" = "\"", "escapeChar" = "\\") STORED AS TEXTFILE LOCATION '/datalake/raw/ehr_cerner/patients' TBLPROPERTIES ("skip.header.line.count"="1");
CREATE EXTERNAL TABLE IF NOT EXISTS encounters (encounter_id STRING, mrn STRING, encounter_type STRING, department STRING, attending_id STRING, admit_ts STRING, discharge_ts STRING, bed_id STRING, triage_level STRING, ed_wait_minutes STRING, discharge_disposition STRING, readmission_flag STRING, source_system STRING) ROW FORMAT SERDE 'org.apache.hadoop.hive.serde2.OpenCSVSerde' WITH SERDEPROPERTIES ("separatorChar" = ",","quoteChar" = "\"", "escapeChar" = "\\") STORED AS TEXTFILE LOCATION '/datalake/raw/ehr_cerner/encounters' TBLPROPERTIES ("skip.header.line.count"="1");
CREATE EXTERNAL TABLE IF NOT EXISTS diagnoses (encounter_id STRING, seq STRING, icd10_code STRING, description STRING, dx_type STRING, recorded_at STRING) ROW FORMAT SERDE 'org.apache.hadoop.hive.serde2.OpenCSVSerde' WITH SERDEPROPERTIES ("separatorChar" = ",", "quoteChar" = "\"", "escapeChar" = "\\") STORED AS TEXTFILE LOCATION '/datalake/raw/ehr_cerner/diagnoses' TBLPROPERTIES ("skip.header.line.count"="1");
CREATE EXTERNAL TABLE IF NOT EXISTS claims (claim_id STRING, encounter_id STRING, mrn STRING, payer STRING, submitted_date STRING, total_amount STRING, status STRING, denial_code STRING, denial_reason STRING, paid_amount STRING, paid_date STRING, resubmission_of STRING) ROW FORMAT SERDE 'org.apache.hadoop.hive.serde2.OpenCSVSerde' WITH SERDEPROPERTIES ("separatorChar" = ",", "quoteChar" = "\"", "escapeChar" = "\\") STORED AS TEXTFILE LOCATION '/datalake/raw/billing_oracle' TBLPROPERTIES ("skip.header.line.count"="1");
SELECT 'patients', COUNT(*) FROM patients UNION ALL SELECT 'encounters', COUNT(*) FROM encounters UNION ALL
SELECT 'diagnoses', COUNT(*) FROM diagnoses UNION ALL SELECT 'claims', COUNT(*) FROM claims;
